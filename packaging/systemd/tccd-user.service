[Unit]
Description=TuxedoRustCenter session agent (display mode, UVC controls)
Documentation=file:/usr/share/doc/tuxedo-rust-center/TCC_USER_DESIGN.md
PartOf=graphical-session.target
After=graphical-session.target
# Le paquet installe aussi
# /usr/lib/systemd/user/graphical-session.target.wants/tccd-user.service,
# ce qui active l'agent pour toutes les sessions sans `systemctl --user enable`.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/libexec/tuxedo-rust-center/tccd-user
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

# Agent non privilégié : aucun accès à /etc, /dev/tuxedo_io ni sysfs.
NoNewPrivileges=yes
# NOTE (R-21) : ces options nécessitent les namespaces utilisateur non
# privilégiés. Si la distribution les restreint (par ex.
# kernel.apparmor_restrict_unprivileged_userns=1), l'unité échouera au
# démarrage : voir docs/packaging/MIGRATION.md §Dépannage pour le drop-in de
# repli documenté.
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Pas de PrivateTmp : le socket X11 /tmp/.X11-unix doit rester visible pour le
# backend XRandR. Wayland utilise $XDG_RUNTIME_DIR.
# Pas de PrivateDevices/DeviceAllow : l'agent ouvre À LA DEMANDE un nœud
# /dev/videoN en lecture/écriture pour User1.SetUvcControl (allowlist de
# contrôles V4L2, rate limit, erreurs typées). L'accès repose sur les
# permissions du nœud : ACL `uaccess` posée par logind pour l'utilisateur de
# la session, ou appartenance au groupe `video`. Aucun privilège, aucun
# polkit (bus de session), aucune capacité.
#   - PrivateDevices=yes recréerait un /dev sans les nœuds caméra ;
#   - DeviceAllow figerait des chemins dynamiques (/dev/video0, video2, ...)
#     et ne remplacerait pas les permissions POSIX/ACL.
# Ne pas les ajouter. Limite : une autre application peut détenir la caméra ;
# l'agent renvoie alors une erreur typée (Busy) sans insister ni contourner
# l'exclusion mutuelle du noyau.

# X11 (socket UNIX), Wayland (socket/compositeur, D-Bus de session) et bus
# système sont tous des sockets UNIX. Aucun accès réseau.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
LimitCORE=0
MemoryMax=128M
TasksMax=32

CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=graphical-session.target
