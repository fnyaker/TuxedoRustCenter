// Chaînes d'interface FR/EN/DE et formats localisés.
//
// Choix assumé : dictionnaire embarqué pour permettre le changement de langue
// à chaud sans redémarrage, sans étape lrelease. Ce singleton pourra être
// remplacé par des catalogues Qt Linguist (.ts/.qm) générés avec lupdate ; les
// clés ci-dessous servent de source d'extraction. Aucune logique métier ici.

pragma Singleton
import QtQuick

QtObject {
    id: root

    property string lang: "fr"

    readonly property var dict: lang === "de" ? de : (lang === "en" ? en : fr)
    readonly property var locale: lang === "de" ? Qt.locale("de_DE")
                                 : lang === "en" ? Qt.locale("en_US") : Qt.locale("fr_FR")

    // Traduction simple. Retourne la clé si absente (visible en dev, jamais en prod).
    function t(key) {
        var v = dict[key];
        return v === undefined ? key : v;
    }

    // Traduction avec substitution de %1..%9.
    function tf(key, args) {
        var s = t(key);
        for (var i = 0; i < args.length; ++i)
            s = s.replace("%" + (i + 1), args[i]);
        return s;
    }

    function plural(n, oneKey, manyKey) {
        return t(n > 1 ? manyKey : oneKey);
    }

    function profileCount(n) {
        return n + " " + plural(n, "profiles.unit", "profiles.unitPlural");
    }

    // Résumé d'export/import (compteurs déjà bornés côté Rust).
    function exportResult(n) {
        return tf(plural(n, "profiles.exportedOne", "profiles.exportedMany"),
                  [formatNumber(n)]);
    }

    function importResult(imported, renamed, skipped) {
        var parts = [tf(plural(imported, "profiles.importedOne",
                               "profiles.importedMany"), [formatNumber(imported)])];
        if (renamed > 0)
            parts.push(tf(plural(renamed, "profiles.renamedOne",
                                 "profiles.renamedMany"), [formatNumber(renamed)]));
        if (skipped > 0)
            parts.push(tf(plural(skipped, "profiles.skippedOne",
                                 "profiles.skippedMany"), [formatNumber(skipped)]));
        return parts.join(" · ");
    }

    function formatNumber(value, decimals) {
        if (value === undefined || value === null || isNaN(value))
            return "—";
        return Number(value).toLocaleString(locale, "f", decimals === undefined ? 0 : decimals);
    }

    function formatTemp(celsius) {
        return formatNumber(fahrenheit ? celsius * 9 / 5 + 32 : celsius, 0) + " " + tempUnit;
    }

    property bool fahrenheit: false
    readonly property string tempUnit: fahrenheit ? "°F" : "°C"

    function tempValue(celsius) {
        if (celsius === undefined || celsius === null || isNaN(celsius))
            return "—";
        return formatNumber(fahrenheit ? celsius * 9 / 5 + 32 : celsius, 0);
    }

    function formatFreq(ghz) {
        return formatNumber(ghz, 2) + " GHz";
    }

    function formatPower(watt) {
        return formatNumber(watt, 1) + " W";
    }

    function formatPercent(value) {
        return formatNumber(value, 0) + " %";
    }

    function formatHz(hz) {
        return formatNumber(hz, 0) + " Hz";
    }

